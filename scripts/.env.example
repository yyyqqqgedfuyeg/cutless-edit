# Copy this file to .env in the same scripts directory and fill in your own key.
# Never commit scripts/.env. API settings are read only from that local file.
DASHSCOPE_API_KEY=your_dashscope_api_key_here
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1
ASR_MODEL=qwen-audio-3.0-asr-flash-filetrans
